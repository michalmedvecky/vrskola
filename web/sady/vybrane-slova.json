    "strelba": ["PRAVÁ ruka strieľa slová napísané SPRÁVNE", "ĽAVÁ ruka strieľa slová napísané NESPRÁVNE"],
    "mece": ["ZELENÝ meč (pravá ruka) seká slová napísané SPRÁVNE", "ČERVENÝ meč (ľavá ruka) seká slová napísané NESPRÁVNE"],
    "karty": ["Na kartách chýba písmeno. Doplň Y, alebo I?", "Vystreľ správne písmeno pod slovom, hoci ktoroukoľvek rukou."],
    "bludiste": ["Na križovatke choď tam, kam ukazuje slovo napísané SPRÁVNE.", "Zlá cesta končí pri príšere – rozsekni ju mečom, alebo uteč!"],
    "cviceni": ["Slová napísané správne sú ZELENÉ,", "slová napísané nesprávne sú ČERVENÉ."],
    "cviceniKarty": ["Správne písmeno svieti NAZELENO, nesprávne NAČERVENO."],
    "cviceniBludiste": ["Šípka so slovom napísaným správne je ZELENÁ,", "šípka so slovom napísaným nesprávne je ČERVENÁ."]
